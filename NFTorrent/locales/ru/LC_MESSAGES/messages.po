#: NFTorrent/indexer/notifications.py:62
msgid ""
"🕊️ You have just minted memorial NFT\n"
"\n"
"Storage due date: {due_date}"
msgstr ""
"🕊️ Ваш памятный NFT был создан\n"
"\n"
"Хранится до: {due_date}"

#: NFTorrent/indexer/notifications.py:106
msgid ""
"⚠️ The guaranteed storage period for your NFT IPFS content ends on "
"<b>{due_date}</b>.\n"
"\n"
"To keep your files available, consider extending it. Without renewal, "
"availability after <b>{due_date}</b> cannot be guaranteed.\n"
"\n"
"We offers this service in exchange for a donation — your "
"support helps keep service and your files online.\n"
msgstr ""
"⚠️ Гарантированный срок хранения IPFS-контента вашего NFT "
"истекает <b>{due_date}</b>.\n"
"\n"
"Чтобы сохранить доступность файлов, рассмотрите возможность продления.Без"
" продления, доступность после <b>{due_date}</b> не гарантируется.\n"
"\n"
"Мы предоставляем эту услугу в обмен на пожертвование — ваша "
"поддержка помогает поддерживать сервис и сохранять файлы доступными.\n"

#: NFTorrent/indexer/notifications.py:113
msgid "Donate (Renew storage)"
msgstr "Поддержать (Продлить хранение)"

