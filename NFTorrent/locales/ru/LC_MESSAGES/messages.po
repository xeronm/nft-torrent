#: NFTorrent/bot/handlers/admin.py:75 NFTorrent/bot/handlers/nft.py:77
msgid "◀️ Prev"
msgstr "◀️ Назад"

#: NFTorrent/bot/handlers/admin.py:80 NFTorrent/bot/handlers/nft.py:83
msgid "Next ▶️"
msgstr "Далее ▶️"

#: NFTorrent/bot/handlers/admin.py:83
msgid ""
"Please select an Inquiry from the list to <b>view</b> details.\n"
"\n"
"List of Inquiries from {from_index} to {to_index}:"
msgstr ""
"Пожалуйста выберите обращение из списка для <b>просмотра</b> деталей.\n"
"\n"
"Список обращений с {from_index} по {to_index}:"

#: NFTorrent/bot/handlers/admin.py:91
msgid "There are no opened inquiries starting from position {from_index}"
msgstr "Нет открытых обращений начиная с позиции {from_index}"

#: NFTorrent/bot/handlers/admin.py:99
msgid "There are no opened inquiries!"
msgstr "Нет открытых обращений!"

#: NFTorrent/bot/handlers/admin.py:132 NFTorrent/bot/handlers/inquiry.py:122
#: NFTorrent/bot/handlers/inquiry.py:256
msgid "Failed to get Inquiry: {errorname}"
msgstr "Не удалось получить Обращение: {errorname}"

#: NFTorrent/bot/handlers/admin.py:137
msgid ""
"Inquiry: #R{inquiry_num:06d} from @{username}\n"
"\n"
"Created: {created}\n"
"Updated: {updated}\n"
"Disabled to: {block_date}\n"
"Closed: {closed}"
msgstr ""

#: NFTorrent/bot/handlers/inquiry.py:48
msgid "⚠️ Your Inquiry session has expired. Please start a new one with /inquiry."
msgstr ""
"⚠️ Время вашего сеанса заполенния обращения истекло. Пожалуйста, начните "
"новое обращение с помощью /inquiry."

#: NFTorrent/bot/handlers/inquiry.py:60
msgid ""
"⚠️ The inquiry #R{inquiry_num:06d} has already been closed and cannot be "
"updated."
msgstr "⚠️ Обращение  #R{inquiry_num:06d} уже закрыто и не может быть изменено."

#: NFTorrent/bot/handlers/inquiry.py:74
msgid ""
"🚫 User Inquiry #R{inquiry_num:06d} has been <b>blocked</b> up to "
"{block_date} UTC."
msgstr ""
"🚫 Запрос пользователя #R{inquiry_num:06d} был <b>заблокирован</b> до "
"{block_date} UTC."

#: NFTorrent/bot/handlers/inquiry.py:93
msgid "Reply has been cancelled."
msgstr "Создание ответа было отменено."

#: NFTorrent/bot/handlers/inquiry.py:142 NFTorrent/bot/handlers/inquiry.py:265
msgid "Reply message"
msgstr "Ответ на сообщение"

#: NFTorrent/bot/handlers/inquiry.py:144 NFTorrent/bot/handlers/inquiry.py:269
msgid "Close message"
msgstr "Сообщение закрытия"

#: NFTorrent/bot/handlers/inquiry.py:155
msgid "Type your <b>{action_message}</b> to your Inquiry #R{inquiry_num:06d}."
msgstr ""
"Введите ваше <b>{action_message}</b> к вашему Обращению "
"#R{inquiry_num:06d}."

#: NFTorrent/bot/handlers/inquiry.py:190 NFTorrent/bot/handlers/inquiry.py:339
msgid "Failed to update Inquiry: {errorname}"
msgstr "Ошибка изменения Обращения: {errorname}"

#: NFTorrent/bot/handlers/inquiry.py:198
msgid ""
"📩 Inquiry #R{inquiry_num:06d} from user @{username} has received a "
"<b>Reply</b> from the user with the following message\n"
"\n"
"{message}"
msgstr ""
"📩 По Обращению #R{inquiry_num:06d} пользователя @{username} получен "
"<b>Ответ</b> от пользователя со следующим сообщением\n"
"\n"
"{message}"

#: NFTorrent/bot/handlers/inquiry.py:208
msgid "📩 You’ve sent a reply to your inquiry #R{inquiry_num:06d}."
msgstr "📩 Вы отправили ответ по вашему обращению #R{inquiry_num:06d}."

#: NFTorrent/bot/handlers/inquiry.py:214
msgid ""
"✅ Inquiry #R{inquiry_num:06d} from user @{username} has been "
"<b>Closed</b> by user with the following message\n"
"\n"
"{message}"
msgstr ""
"✅ Обращение #R{inquiry_num:06d} от пользователя @{username} было "
"<b>Закрыто</b> пользователем со следующим сообщением\n"
"\n"
"{message}"

#: NFTorrent/bot/handlers/inquiry.py:221
msgid "✅ Your Inquiry #R{inquiry_num:06d} has been closed."
msgstr "✅ Ваше Обращение #R{inquiry_num:06d} было закрыто."

#: NFTorrent/bot/handlers/inquiry.py:267
msgid "Block user message"
msgstr "Сообщение блокировки пользователя"

#: NFTorrent/bot/handlers/inquiry.py:281
msgid ""
"Type your <b>{action_message}</b> to user's @{username} Inquiry "
"#R{inquiry_num:06d} or cancel\n"
"Language - <b>{lang}</b>.\n"
msgstr ""
"Введите ваше <b>{action_message}</b> по Обращению пользователя "
"@{username}#R{inquiry_num:06d} или нажмите отмена\n"
"Язык сообщения - <b>{lang}</b>.\n"

#: NFTorrent/bot/handlers/inquiry.py:347
msgid "Replied"
msgstr "Ответ"

#: NFTorrent/bot/handlers/inquiry.py:351
msgid "Blocked"
msgstr "Блокировка"

#: NFTorrent/bot/handlers/inquiry.py:354
msgid "Closed"
msgstr "Закрытие"

#: NFTorrent/bot/handlers/inquiry.py:359
msgid ""
"{action_icon} Your Inquiry #R{inquiry_num:06d} has been "
"<b>{action_message}</b> with the following message\n"
"\n"
"{message}"
msgstr ""
"{action_icon} По вашему Обращению #R{inquiry_num:06d} был "
"выполнен<b>{action_message}</b> со следующим сообщением\n"
"\n"
"{message}"

#: NFTorrent/bot/handlers/inquiry.py:372
msgid ""
"{action_icon} Inquiry #R{inquiry_num:06d} from user @{username} has been "
"<b>{action_message}</b>."
msgstr ""
"{action_icon} По Обращению #R{inquiry_num:06d} от пользователя "
"@{username} был выполнен <b>{action_message}</b>."

#: NFTorrent/bot/handlers/inquiry.py:398
msgid "Your Inquiry has been cancelled."
msgstr "Ваше Обращение было отменено."

#: NFTorrent/bot/handlers/inquiry.py:426
msgid ""
"⚠️ You have already started filling out an inquiry. If you want to start "
"over press \"Cancel\"."
msgstr ""
"⚠️ Вы уже начали заполнение обращения. Если вы желаете начать с начала "
"нажмите кнопку \"Cancel\"."

#: NFTorrent/bot/handlers/inquiry.py:435
msgid ""
"<b>You starting to fill new Inquiry.</b>\n"
"\n"
"Please provide following information:\n"
" • Subject\n"
" • Message\n"
" • NFT address (optional)\n"
" • Screenshot (optional)\n"
"\n"
msgstr ""
"<b>Вы начали заполнение нового Обращения.</b>\n"
"\n"
"Пожалуйста предоставьте следующую информацию:\n"
" • Тему обращения\n"
" • Текст обращения\n"
" • Адрес NFT (необязательно)\n"
" • Снимок экрана (необязательно)\n"
"\n"

#: NFTorrent/bot/handlers/inquiry.py:443
msgid "<b>Step 1/5</b>: Enter your inquiry <b>Subject</b>"
msgstr "<b>Шаг 1/5</b>: Введите <b>Тему</b> вашего обращения"

#: NFTorrent/bot/handlers/inquiry.py:455
msgid "<b>Step 2/5</b>: Enter your inquiry <b>Message</b>"
msgstr "<b>Шаг 2/5</b>: Введите <b>Текст</b> вашего обращения"

#: NFTorrent/bot/handlers/inquiry.py:467
msgid ""
"<b>Step 3/5</b>: You can optionally provide an <b>NFT address</b>, or go "
"to the next step."
msgstr ""
"<b>Шаг 3/5</b>: Опционально вы можете предоставить <b>Адрес NFT</b>, или "
"перейти к следующему шагу."

#: NFTorrent/bot/handlers/inquiry.py:477
msgid ""
"<b>Step 4/5</b>: You can optionally add a <b>Screenshot</b> to describe "
"your inquiry, or go to the next step."
msgstr ""
"<b>Шаг 4/5</b>: Опционально вы можете приложить <b>Снимок экрана</b>, "
"соответствующий теме вашего обращения, или перейти к следующему шагу."

#: NFTorrent/bot/handlers/inquiry.py:492
msgid ""
"The input you provided is not a valid TON address. Please send a valid "
"<b>NFT address</b>"
msgstr ""
"Предоставлен некорректный TON-адрес. Пожалуйста отправьте корректный "
"<b>Адрес NFT</b>"

#: NFTorrent/bot/handlers/inquiry.py:507
msgid ""
"<b>Step 4/5</b>: Got <b>{count}</b> image(s). You can optionally add "
"another <b>Screenshot</b>, or go to the next step."
msgstr ""
"<b>Шаг 4/5</b>: Приложено <b>{count}</b> изображений. Опционально вы "
"можете приложить еще <b>Снимок экрана</b>, или перейти к следующему шагу."

#: NFTorrent/bot/handlers/inquiry.py:518
msgid "<b>Step 5/5</b>: Do you want to submit your Inquiry <b>{subject}</b>?"
msgstr "<b>Шаг 5/5</b>: Вы желаете отправить ваше Обращение <b>{subject}</b>?"

#: NFTorrent/bot/handlers/inquiry.py:544
msgid ""
"⚠️ You already have an open inquiry #R{inquiry_num:06d}.\n"
"You must either <b>respond</b> to it or <b>close</b> it before submitting"
" a new one."
msgstr ""
"⚠️ У вас уже есть октрытое обращение #R{inquiry_num:06d}.\n"
"Вы должны либо ответить <b>respond</b> в него либо <b>закрыть</b> его "
"перед созданием нового."

#: NFTorrent/bot/handlers/inquiry.py:567
msgid "Submit Inquiry error: {errorname}"
msgstr "Ошибка создания Обращения: {errorname}"

#: NFTorrent/bot/handlers/inquiry.py:576
msgid ""
"🆕 Inquiry #R{inquiry_num:06d} from user @{username}:\n"
"\n"
"<b>{subject}</b>"
msgstr ""
"🆕 Обращение #R{inquiry_num:06d} от пользователя @{username}:\n"
"\n"
"<b>{subject}</b>"

#: NFTorrent/bot/handlers/nft.py:64
msgid "Connect wallet"
msgstr "Подключить кошелек"

#: NFTorrent/bot/handlers/nft.py:67
msgid ""
"To view your NFTs using this command, you must first authorize through "
"the Mini App."
msgstr ""
"Для просмотра ваших NFT с использованием данной команды, вам необходимо "
"сначала авторизоваться через Mini App."

#: NFTorrent/bot/handlers/nft.py:84
msgid "✨ Mint"
msgstr ""

#: NFTorrent/bot/handlers/nft.py:87
msgid ""
"Please select an NFT from the list to <b>view</b> details, or <b>mint</b>"
" a new one.\n"
"\n"
"List of NFTs from {from_index} to {to_index}:"
msgstr ""
"Пожалуйста выберите NFT из списка для <b>просмотра</b>, либо "
"<b>создайте</b> новый.\n"
"Список NFT с {from_index} по {to_index}:"

#: NFTorrent/bot/handlers/nft.py:95
msgid "You don’t have any NFTs starting from position {from_index}"
msgstr "У вас нет памятных NFT начиная с позиции {from_index}"

#: NFTorrent/bot/handlers/nft.py:101
msgid "You don't have any memorial NFTs yet. Consider minting your first one!"
msgstr ""
"У вас пока нет памтных NFT для просмотра. Самое время создать ваш первый "
"NFT!"

#: NFTorrent/bot/handlers/nft.py:123
msgid "Your request has been cancelled."
msgstr "Ваш запрос был отменен."

#: NFTorrent/bot/handlers/nft.py:136
msgid "Send <b>NFT address</b> to view NFT."
msgstr "Отправьте <b>NFT address</b> для просмотра NFT."

#: NFTorrent/bot/handlers/nft.py:144
msgid ""
"Provided input is not a valid TON Address. Please send the valid <b>NFT "
"address</b>."
msgstr ""
"Введен не корректный TON-адрес. Пожалуйста отправьте корректный <b>Адрес "
"NFT</b>."

#: NFTorrent/bot/handlers/nft.py:165
msgid ""
"The input you provided is not a valid TON address. Please send a valid "
"<b>NFT address</b>."
msgstr ""
"Введен не корректный TON-адрес. Пожалуйста отправьте корректный <b>Адрес "
"NFT</b>."

#: NFTorrent/bot/handlers/nft.py:188
msgid "NFT <code>{address}</code> not found or not indexed yet."
msgstr "NFT <code>{address}</code> не найдено либо еще не проиндексировано."

#: NFTorrent/bot/handlers/nft.py:199
msgid "Failed to view NFT <code>{address}</code>, error - {errorname}"
msgstr "Не удалось просмотреть NFT <code>{address}</code>, ошибка - {errorname}"

