#: NFTorrent/bot/handlers/admin.py:75 NFTorrent/bot/handlers/nft.py:76
msgid "◀️ Prev"
msgstr "◀️ Назад"

#: NFTorrent/bot/handlers/admin.py:80 NFTorrent/bot/handlers/nft.py:82
msgid "Next ▶️"
msgstr "Далее ▶️"

#: NFTorrent/bot/handlers/admin.py:83
msgid ""
"Please select an Inquiry from the list to <b>view</b> details.\n"
"\n"
"List of Inquiries from {from_index} to {to_index}:"
msgstr ""
"Пожалуйста выберите обращение из списка для <b>просмотра</b> деталей.\n"
"\n"
"Список обращений с {from_index} по {to_index}:"

#: NFTorrent/bot/handlers/admin.py:88
msgid "There are no opened inquiries starting from position {from_index}"
msgstr "Нет открытых обращений с позиции {from_index}"

#: NFTorrent/bot/handlers/admin.py:93
msgid "There are no opened inquiries!"
msgstr "Нет открытых обращений!"

#: NFTorrent/bot/handlers/admin.py:126 NFTorrent/bot/handlers/inquiry.py:106
#: NFTorrent/bot/handlers/inquiry.py:247
msgid "Failed to get Inquiry: {errorname}"
msgstr "Не удалось получить Обращение: {errorname}"

#: NFTorrent/bot/handlers/admin.py:131
msgid ""
"Inquiry: #R{inquiry_num:06d} from @{username}\n"
"\n"
"Created: {created}\n"
"Updated: {updated}\n"
"Disabled to: {block_date}\n"
"Closed: {closed}"
msgstr ""

#: NFTorrent/bot/handlers/inquiry.py:48
msgid "⚠️ Your Inquiry session has expired. Please start a new one with /inquiry."
msgstr "⚠️ Время вашего сеанса заполенния обращения истекло. Пожалуйста, начните"
" новое обращение с помощью /inquiry."

#: NFTorrent/bot/handlers/inquiry.py:60
msgid ""
"⚠️ The inquiry #R{inquiry_num:06d} has already been closed and cannot be "
"updated."
msgstr ""
"⚠️ Обращение  #R{inquiry_num:06d} уже закрыто и не может быть изменено."

#: NFTorrent/bot/handlers/inquiry.py:74
msgid ""
"🚫 User Inquiry #R{inquiry_num:06d} has been <b>blocked</b> up to "
"{block_date} UTC."
msgstr ""
"🚫 Запрос пользователя #R{inquiry_num:06d} был <b>заблокирован</b> до "
"{block_date} UTC."

#: NFTorrent/bot/handlers/inquiry.py:126 NFTorrent/bot/handlers/inquiry.py:256
msgid "Reply message"
msgstr "Ответ на сообщение"

#: NFTorrent/bot/handlers/inquiry.py:128 NFTorrent/bot/handlers/inquiry.py:260
msgid "Close message"
msgstr "Сообщение закрытия"

#: NFTorrent/bot/handlers/inquiry.py:139
msgid ""
"Type your <b>{action_message}</b> or /cancel.\n"
"It will be added to your Inquiry #R{inquiry_num:06d}."
msgstr ""
"Введите ваше <b>{action_message}</b> или /cancel.\n"
"Данное сообщение будет добавлено к вашему Обращению #R{inquiry_num:06d}."

#: NFTorrent/bot/handlers/inquiry.py:181 NFTorrent/bot/handlers/inquiry.py:335
msgid "Failed to update Inquiry: {errorname}"
msgstr "Ошибка изменения Обращения: {errorname}"

#: NFTorrent/bot/handlers/inquiry.py:189
msgid ""
"📩 Inquiry #R{inquiry_num:06d} from user @{username} has received a "
"<b>Reply</b> from the user with the following message\n"
"\n"
"{message}"
msgstr ""
"📩 По Обращению #R{inquiry_num:06d} пользователя @{username} получен ответ "
"<b>Reply</b> от пользователя со следующим сообщением\n"
"\n"
"{message}"

#: NFTorrent/bot/handlers/inquiry.py:199
msgid "📩 You’ve sent a reply to your inquiry #R{inquiry_num:06d}."
msgstr "📩 Вы отправили ответ по вашему обращению #R{inquiry_num:06d}."

#: NFTorrent/bot/handlers/inquiry.py:205
msgid ""
"✅ Inquiry #R{inquiry_num:06d} from user @{username} has been "
"<b>Closed</b> by user with the following message\n"
"\n"
"{message}"
msgstr ""
"✅ Обращение #R{inquiry_num:06d} от пользователя @{username} было "
"<b>Закрыто</b> пользователем со следующим сообщением\n"
"\n"
"{message}"

#: NFTorrent/bot/handlers/inquiry.py:212
msgid "✅ Your Inquiry #R{inquiry_num:06d} has been closed."
msgstr "✅ Ваше Обращение #R{inquiry_num:06d} было закрыто."

#: NFTorrent/bot/handlers/inquiry.py:258
msgid "Block user message"
msgstr "Сообщение блокировки пользователя"

#: NFTorrent/bot/handlers/inquiry.py:272
msgid ""
"Type your <b>{action_message}</b> to Inquiry #R{inquiry_num:06d} or "
"/cancel, language - <b>{lang}</b>.\n"
"It will be delivered to the user @{username}."
msgstr ""
"Введите ваше <b>{action_message}</b> к Обращению #R{inquiry_num:06d} или "
"/cancel, язык - <b>{lang}</b>.\n"
"It will be delivered to the user @{username}."

#: NFTorrent/bot/handlers/inquiry.py:343
msgid "Replied"
msgstr "Ответ"

#: NFTorrent/bot/handlers/inquiry.py:347
msgid "Blocked"
msgstr "Блокировка"

#: NFTorrent/bot/handlers/inquiry.py:350
msgid "Closed"
msgstr "Закрытие"

#: NFTorrent/bot/handlers/inquiry.py:355
msgid ""
"{action_icon} Your Inquiry #R{inquiry_num:06d} has been "
"<b>{action_message}</b> with the following message\n"
"\n"
"{message}"
msgstr ""
"{action_icon} По вашему Обращению #R{inquiry_num:06d} был "
"выполнен<b>{action_message}</b> со следующим сообщением\n"
"\n"
"{message}"

#: NFTorrent/bot/handlers/inquiry.py:368
msgid ""
"{action_icon} Inquiry #R{inquiry_num:06d} from user @{username} has been "
"<b>{action_message}</b>."
msgstr ""
"{action_icon} По Обращению #R{inquiry_num:06d} от пользователя "
"@{username} был выполнен <b>{action_message}</b>."

#: NFTorrent/bot/handlers/inquiry.py:394
msgid "Your Inquiry has been cancelled."
msgstr "Ваше Обращение было отменено."

#: NFTorrent/bot/handlers/inquiry.py:410
msgid ""
"⚠️ You have already started filling out an inquiry. If you want to start "
"over press \"Cancel\"."
msgstr ""
"⚠️ Вы уже начали заполнение обращения. Если вы желаете начать с начала "
"нажмите кнопку \"Cancel\"."

#: NFTorrent/bot/handlers/inquiry.py:419
msgid ""
"<b>You starting to fill new Inquiry.</b>\n"
"\n"
"Please provide following information:\n"
" • Subject\n"
" • Message\n"
" • NFT address (optional)\n"
" • Screenshot (optional)\n"
"\n"
msgstr ""
"<b>Вы начали заполнение нового Обращения.</b>\n"
"\n"
"Пожалуйста предоставьте следующую информацию:\n"
" • Тему обращения\n"
" • Текст обращения\n"
" • Адрес NFT (необязательно)\n"
" • Снимок экрана (необязательно)\n"
"\n"

#: NFTorrent/bot/handlers/inquiry.py:430
msgid "Enter your inquiry <b>Subject</b>:"
msgstr "Введите <b>Тему</b> вашего обращения:"

#: NFTorrent/bot/handlers/inquiry.py:440
msgid "Enter your inquiry <b>Message</b>:"
msgstr "Введите <b>Текст</b> вашего обращения:"

#: NFTorrent/bot/handlers/inquiry.py:450
msgid ""
"You can optionally provide an <b>NFT address</b>, or simply go to the "
"/next step."
msgstr ""
"Опционально вы можете отправить <b>Адрес NFT</b>, или перейти /next к "
"следующему шагу"

#: NFTorrent/bot/handlers/inquiry.py:459
msgid ""
"You can optionally add a <b>Screenshot</b> to describe your inquiry, or "
"simply proceed to the /next step."
msgstr ""
"Опционально вы можете приложить <b>Снимок экрана</b>, описывающий ваше "
"обращение, или перейти к следующему шагу /next."

#: NFTorrent/bot/handlers/inquiry.py:471
msgid ""
"The input you provided is not a valid TON address. Please send a valid "
"<b>NFT address</b>, or proceed to the /next step."
msgstr ""
"Предоставлен некорректный TON-адрес. Пожалуйста отправьте корректный "
"<b>Адрес NFT</b> либо перейдите к следующему шагу /next."

#: NFTorrent/bot/handlers/inquiry.py:488
msgid ""
"Got {count} images. You can optionally add another <b>Screenshot</b> or "
"simply proceed to the /next step."
msgstr ""
"Приложено {count} изображений. Опционально вы можете приложить еще "
"<b>Снимок экрана</b>, или перейти к следующему шагу /next."

#: NFTorrent/bot/handlers/inquiry.py:499
msgid "Do you want to submit your Inquiry <b>{subject}</b>?"
msgstr "Вы желаете отправить ваше Обращение <b>{subject}</b>?"

#: NFTorrent/bot/handlers/inquiry.py:525
msgid ""
"⚠️ You already have an open inquiry #R{inquiry_num:06d}.\n"
"You must either <b>respond</b> to it or <b>close</b> it before submitting"
" a new one."
msgstr ""
"⚠️ У вас уже есть октрытое обращение #R{inquiry_num:06d}.\n"
"Вы должны либо ответить <b>respond</b> в него либо <b>закрыть</b> его "
"перед созданием нового."

#: NFTorrent/bot/handlers/inquiry.py:548
msgid "Submit Inquiry error: {errorname}"
msgstr "Ошибка создания Обращения: {errorname}"

#: NFTorrent/bot/handlers/inquiry.py:557
msgid ""
"🆕 Inquiry #R{inquiry_num:06d} from user @{username}:\n"
"\n"
"<b>{subject}</b>"
msgstr ""
"🆕 Обращение #R{inquiry_num:06d} от пользователя @{username}:\n"
"\n"
"<b>{subject}</b>"

#: NFTorrent/bot/handlers/nft.py:63
msgid "Connect wallet"
msgstr "Подключить кошелек"

#: NFTorrent/bot/handlers/nft.py:66
msgid ""
"To view your NFTs using this command, you must first authorize through "
"the Mini App."
msgstr ""
"Для просмотра ваших NFT с использованием данной команды, вам необходимо "
"сначала авторизоваться через Mini App."

#: NFTorrent/bot/handlers/nft.py:83
msgid "✨ Mint"
msgstr ""

#: NFTorrent/bot/handlers/nft.py:86
msgid ""
"Please select an NFT from the list to <b>view</b> details, or <b>mint</b>"
" a new one.\n"
"\n"
"List of NFTs from {from_index} to {to_index}:"
msgstr ""
"Пожалуйста выберите NFT из списка для <b>просмотра</b>, либо "
"<b>создайте</b> новый.\n"
"Список NFT с {from_index} по {to_index}:"

#: NFTorrent/bot/handlers/nft.py:94
msgid "You don’t have any NFTs starting from position {from_index}"
msgstr "У вас нет памятных NFT начиная с позиции {from_index}"

#: NFTorrent/bot/handlers/nft.py:100
msgid "You don't have any memorial NFTs yet. Consider minting your first one!"
msgstr ""
"У вас пока нет памтных NFT для просмотра. Самое время создать ваш первый "
"NFT!"

#: NFTorrent/bot/handlers/nft.py:120
msgid "Send <b>NFT address</b> to view or /cancel."
msgstr "Отправьте <b>NFT address</b> для просмотра либо отмените /cancel."

#: NFTorrent/bot/handlers/nft.py:128
msgid ""
"Provided input is not a valid TON Address. Please send the valid <b>NFT "
"address</b> or just /cancel."
msgstr ""
"Введен не корректный TON-адрес. Пожалуйста отправьте корректный <b>Адрес "
"NFT</b> либо либо отмените /cancel."

#: NFTorrent/bot/handlers/nft.py:148
msgid ""
"The input you provided is not a valid TON address. Please send a valid "
"<b>NFT address</b>, or just /cancel."
msgstr ""
"Введен не корректный TON-адрес. Пожалуйста отправьте корректный <b>Адрес "
"NFT</b> либо отмените /cancel."

#: NFTorrent/bot/handlers/nft.py:172
msgid "NFT <code>{address}</code> not found or not indexed yet."
msgstr "NFT <code>{address}</code> не найдено либо еще не проиндексировано."

#: NFTorrent/bot/handlers/nft.py:183
msgid "Failed to view NFT <code>{address}</code>, error - {errorname}"
msgstr "Не удалось просмотреть NFT <code>{address}</code>, ошибка - {errorname}"

